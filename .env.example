# 数据库连接（MySQL 或 SQLite 均可；sqlite 便于本地调试）
DATABASE_URL=mysql://username:password@host:3306/lingcommunity
# DATABASE_URL=sqlite:///./test.db

# 令牌签名密钥（务必修改为随机字符串）
SECRET_KEY=please-change-me

# 初始管理员（首次启动、用户表为空时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

DEBUG=False
HOST=0.0.0.0
PORT=8000

# 登录令牌有效期（秒）
TOKEN_TTL=604800
